{
  "name": "srs-sugar-complaint",
  "version": "1.0.0",
  "description": "ระบบข้อร้องเรียนสินค้า (น้ำตาล) — บริษัท น้ำตาลสุรินทร์ จำกัด",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./public/css/tailwind.src.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./public/css/tailwind.src.css -o ./public/css/app.css --watch",
    "build": "npm run build:css",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
