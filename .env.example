# =============================================================
#  ไฟล์ตั้งค่าระบบ — คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับ server
#  (ห้าม commit ไฟล์ .env จริงที่มีรหัสผ่าน)
# =============================================================

# ---------- แอปพลิเคชัน ----------
NODE_ENV=production
PORT=3000
# URL ที่ผู้ใช้เปิดเข้าระบบ (ใช้ใส่ลิงก์ในอีเมล)
APP_BASE_URL=http://192.168.20.254:3000
# สุ่มค่ายาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# true เมื่อเปิดผ่าน HTTPS เท่านั้น
COOKIE_SECURE=false
# อายุ session (ชั่วโมง)
SESSION_HOURS=10

# ---------- ฐานข้อมูล ----------
# แบบ 1: server ภายในบริษัท (docker compose) -> DB_HOST=db
# แบบ 2: Cloud MySQL (Azure / AWS RDS / Google Cloud SQL) -> ใส่ host ของ cloud และตั้ง DB_SSL=true
DB_HOST=db
DB_PORT=3306
DB_NAME=sugar_complaint
DB_USER=sugar_app
DB_PASSWORD=change-me
DB_SSL=false
# ใช้เฉพาะ docker compose (สร้างฐานข้อมูลครั้งแรก)
DB_ROOT_PASSWORD=change-me-root
# สร้างตารางอัตโนมัติเมื่อเปิดแอป
DB_AUTO_MIGRATE=true

# ---------- ข้อมูลเริ่มต้น ----------
# true = ใส่บัญชีทดลอง (รหัส 1234) + ข้อร้องเรียนตัวอย่าง (ใช้ทดสอบเท่านั้น!)
SEED_DEMO=false
# รหัสผ่านเริ่มต้นของบัญชี admin (ระบบจะบังคับเปลี่ยนเมื่อ login ครั้งแรก)
ADMIN_INITIAL_PASSWORD=ChangeMe!2026

# ---------- ไฟล์แนบ ----------
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=10

# ---------- อีเมล (SMTP) ----------
# ถ้าเว้น SMTP_HOST ว่าง ระบบจะไม่ส่งจริง แต่พิมพ์อีเมลลง console (โหมดทดสอบ)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ระบบข้อร้องเรียนสินค้า <no-reply@surinsugar.co.th>"
